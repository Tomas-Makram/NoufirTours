@model NoufirTours.Models.Trips.Accounts.AdminChangePasswordModel
@{
    Layout = null;
    var nonce = (Context.Items["CSPNonce"]?.ToString()) ?? "";
}

<div class="modal-header">
    <div>
        <h5 class="modal-title mb-0">Change Password</h5>
        <div class="text-muted small">
            Set a new password for <b>@(Model.Username ?? ("User #" + Model.UserId))</b>
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<div class="modal-body">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@ViewBag.Error</div>
        </div>
    }
    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <div>@ViewBag.Success</div>
        </div>
    }

    <form id="frmAdminChangePassword" method="post"
          action="@Url.Action("AdminChangePassword", "Trips")" class="mt-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UserId" value="@Model.UserId" />

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">New Password</label>

                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>

                    <input class="form-control"
                           type="password"
                           name="NewPassword"
                           id="NewPassword"
                           minlength="6"
                           maxlength="100"
                           required
                           autocomplete="new-password"
                           placeholder="Enter new password" />

                    <button class="btn btn-outline-secondary"
                            type="button"
                            id="btnTogglePw"
                            aria-label="Show password"
                            aria-pressed="false"
                            title="Show/Hide password">
                        <i class="bi bi-eye" id="pwEyeIcon"></i>
                    </button>
                </div>

                <div class="form-text">Minimum 6 chars. Share it securely with the user.</div>
            </div>

            <div class="col-12">
                <label class="form-label">Confirm Password</label>

                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-check2-circle"></i></span>

                    <input class="form-control"
                           type="password"
                           name="ConfirmPassword"
                           id="ConfirmPassword"
                           minlength="6"
                           maxlength="100"
                           required
                           autocomplete="new-password"
                           placeholder="Re-enter password" />
                </div>
            </div>

            <div class="col-12 d-flex gap-2 justify-content-end">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save2 me-1"></i> Save Password
                </button>
            </div>
        </div>
    </form>
</div>