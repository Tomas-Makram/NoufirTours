@using System.Globalization
@model NoufirTours.Models.Dashboard.DashboardTripDetailsModel
@{
    ViewData["Title"] = "Trip Details";
    var nonce = (Context.Items["CSPNonce"]?.ToString()) ?? "";
    string V(string? s) => string.IsNullOrWhiteSpace(s) ? "" : s.Trim();
    string Seats(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s.Trim();
}

<style nonce="@nonce">
    .info-card {
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,.08);
        background: rgba(255,255,255,.7);
    }

    [data-bs-theme="dark"] .info-card {
        border-color: rgba(255,255,255,.10);
        background: rgba(255,255,255,.03);
    }

    .muted {
        color: rgba(0,0,0,.6);
    }

    [data-bs-theme="dark"] .muted {
        color: rgba(255,255,255,.65);
    }

    .deleted-table-wrap {
        border: 1px solid rgba(220,53,69,.18);
        border-radius: 14px;
        overflow: hidden;
    }

    .deleted-table-title {
        background: rgba(220,53,69,.08);
        color: #b02a37;
        font-weight: 700;
        padding: 12px 16px;
        border-bottom: 1px solid rgba(220,53,69,.18);
    }

    [data-bs-theme="dark"] .deleted-table-title {
        background: rgba(220,53,69,.16);
        color: #ffb3bd;
        border-bottom-color: rgba(220,53,69,.25);
    }

    .table-danger-soft tbody tr {
        background: rgba(220,53,69,.04);
    }

        .table-danger-soft tbody tr:hover {
            background: rgba(220,53,69,.08);
        }
</style>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h3 class="mb-1">@Model.TripName</h3>
            <div class="muted">
                <span class="fw-semibold">@Model.DepartDate</span> • <span class="fw-semibold">@Model.DepartTime</span>
                <span class="mx-2">|</span>
                <span>@(Model.FromCity ?? "-") → @(Model.ToCity ?? "-")</span>
                @if (Model.IsArchived)
                {
                    <span class="badge bg-secondary ms-2">Archived</span>
                }
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="/Dashboard/Index">Back</a>

            <a class="btn btn-outline-primary"
                   href="/Dashboard/PrintTrip?id=@Model.TripId&company=@V(Model.CompanyFilter)"
                   target="_blank">
                Print / Save PDF
            </a>

            <a class="btn btn-primary"
                   href="/Dashboard/ExportExcel?Day=@Model.DepartDate&Company=@V(Model.CompanyFilter)&AllBookings=false&IncludeArchivedTrips=true">
                Export Excel (this trip day)
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="p-3 info-card">
                <div class="fw-bold mb-2">Trip Info</div>
                <div class="mb-1"><span class="muted">Pickup:</span> @(Model.PickupPlace ?? "-")</div>
                <div class="mb-1"><span class="muted">Dropoff:</span> @(Model.DropoffPlace ?? "-")</div>
                <div><span class="muted">Bookings:</span> <strong>@(Model.Bookings?.Count ?? 0)</strong></div>
            </div>
        </div>

        @if (Model.IsAdmin)
        {
            <div class="col-12 col-lg-6">
                <div class="p-3 info-card">
                    <div class="fw-bold mb-2">Admin Filters</div>
                    <form method="get" action="/Dashboard/TripDetails/@Model.TripId" class="row g-2 align-items-end">
                        <div class="col-8">
                            <label class="form-label mb-1">Company</label>
                            <input type="text" name="company" value="@V(Model.CompanyFilter)" class="form-control" placeholder="Filter by company..." />
                        </div>
                        <div class="col-4">
                            <button class="btn btn-primary w-100" type="submit">Apply</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Company</th>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Route</th>
                            <th>Dropoff Place</th>
                            <th>Seats</th>
                            @if (Model.IsAdmin)
                            {
                                <th>Code Delete</th>
                            }
                            <th>Details</th>
                            @if (Model.IsAdmin)
                            {
                                <th class="text-end">BookingId</th>
                            }
                            else
                            {
                                <th class="text-end">Ticket</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Bookings == null || Model.Bookings.Count == 0)
                        {
                            <tr>
                                <td colspan="@(Model.IsAdmin ? 9 : 8)" class="text-center py-4 muted">No bookings.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var b in Model.Bookings)
                            {
                                <tr>
                                    <td class="fw-semibold">@b.CompanyFrom</td>
                                    <td>@b.CustomerName</td>
                                    <td>@b.Phone</td>
                                    <td>@b.TripSegment</td>
                                    <td>@(string.IsNullOrWhiteSpace(b.CustomerDropoffPlace) ? "-" : b.CustomerDropoffPlace)</td>
                                    <td class="fw-semibold">@Seats(b.SeatsText)</td>
                                    @if (Model.IsAdmin)
                                    {
                                        <td>@b.CodeDel</td>
                                    }
                                    <td>@b.Description</td>
                                    @if (Model.IsAdmin)
                                    {
                                        <td class="text-end muted">@b.BookingId</td>
                                    }
                                    else
                                    {
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary"
                                                   href="/Booking/Ticket/@b.BookingId"
                                                   target="_blank"
                                                   rel="noopener">
                                                Ticket
                                            </a>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="deleted-table-wrap">
        <div class="deleted-table-title">
            Deleted Tickets For This Trip
            @if (!Model.IsAdmin)
            {
                <span class="fw-normal ms-2">(your account only)</span>
            }
            else if (!string.IsNullOrWhiteSpace(Model.CompanyFilter))
            {
                <span class="fw-normal ms-2">(@Model.CompanyFilter)</span>
            }
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 table-danger-soft">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>Segment</th>
                        <th>Seats</th>
                        <th>Total</th>
                        <th>Deleted At</th>
                        <th>Deleted By</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DeletedTickets == null || Model.DeletedTickets.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 muted">No deleted tickets for this trip.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var d in Model.DeletedTickets)
                        {
                            var deletedAt = DateTimeOffset.FromUnixTimeSeconds(d.DeletedAtUnix).LocalDateTime;
                            var segment =
                                d.ReturnTripId == Model.TripId && d.BookingTypeInt == 3 ? "RETURN" :
                                d.TripId == Model.TripId && d.BookingTypeInt == 2 ? "RETURN" :
                                "GO";

                            var seatsText =
                                segment == "RETURN"
                                    ? (string.IsNullOrWhiteSpace(d.SeatsReturnText) ? "-" : d.SeatsReturnText)
                                    : (string.IsNullOrWhiteSpace(d.SeatsText) ? "-" : d.SeatsText);

                            <tr class="text-danger-emphasis">
                                <td class="fw-semibold">@(!string.IsNullOrWhiteSpace(d.TicketCode) ? d.TicketCode : "-")</td>
                                <td>@(d.CustomerName ?? "-")</td>
                                <td>@(d.Phone ?? "-")</td>
                                <td>@(d.CompanyFrom ?? "-")</td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border">@segment</span>
                                </td>
                                <td class="fw-semibold">@seatsText</td>
                                <td>@d.TotalAmount.ToString("0.##", CultureInfo.InvariantCulture)</td>
                                <td>@deletedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@(d.DeletedByUser?.Username ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(d.Notes) ? "-" : d.Notes)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>