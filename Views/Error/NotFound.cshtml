@{
    ViewData["Title"] = "Page Not Found";
    var nonce = (Context.Items["CSPNonce"]?.ToString()) ?? "";
}

<div class="nf-wrap" dir="ltr">
    <div class="container py-5">
        <div class="row align-items-center g-4">

            <!-- Left: Illustration -->
            <div class="col-lg-7 order-2 order-lg-1">
                <div class="scene card border-0 shadow-lg">
                    <div class="card-body p-0 overflow-hidden scene-body">

                        <!-- Sky -->
                        <div class="sky">
                            <div class="sun">
                                <span class="ray r1"></span>
                                <span class="ray r2"></span>
                                <span class="ray r3"></span>
                                <span class="ray r4"></span>
                            </div>

                            <div class="cloud c1"></div>
                            <div class="cloud c2"></div>
                            <div class="cloud c3"></div>

                            <div class="stars"></div>

                            <div class="birds">
                                <span class="bird b1"></span>
                                <span class="bird b2"></span>
                                <span class="bird b3"></span>
                            </div>

                            <div class="mountains">
                                <div class="m m1"></div>
                                <div class="m m2"></div>
                                <div class="m m3"></div>
                            </div>
                        </div>

                        <!-- Road -->
                        <div class="road">
                            <div class="road-perspective"></div>
                            <div class="lane"></div>
                            <div class="lane lane2"></div>

                            <!-- 404 Sign -->
                            <div class="sign">
                                <div class="sign-top">404</div>
                                <div class="sign-sub">Wrong Route</div>
                                <div class="sign-post"></div>
                            </div>

                            <!-- Barrier -->
                            <div class="barrier">
                                <div class="stripe s1"></div>
                                <div class="stripe s2"></div>
                                <div class="stripe s3"></div>
                            </div>

                            <!-- Bus -->
                            <div class="bus-wrap">
                                <div class="bus-shadow"></div>

                                <div class="shake">
                                    <div class="bus">
                                        <div class="bus-glow"></div>

                                        <div class="bus-front-glass"></div>
                                        <div class="bus-strip"></div>

                                        <div class="bus-windows">
                                            <span class="w"></span>
                                            <span class="w"></span>
                                            <span class="w"></span>
                                            <span class="w"></span>
                                            <span class="w"></span>
                                        </div>

                                        <div class="bus-door"></div>

                                        <div class="bus-brand">
                                            <span class="logo-dot"></span>
                                            NoufirTours
                                        </div>

                                        <div class="bus-lights">
                                            <span class="light l1"></span>
                                            <span class="light l2"></span>
                                        </div>

                                        <div class="wheel wheel1"><span class="rim"></span></div>
                                        <div class="wheel wheel2"><span class="rim"></span></div>
                                    </div>
                                </div>

                                <!-- Crash bubble -->
                                <div class="boom">
                                    <div class="boom-text">Oops!</div>
                                </div>

                                <!-- Sparks/particles -->
                                <div class="particles">
                                    <span></span><span></span><span></span><span></span><span></span>
                                </div>

                                <!-- Dust -->
                                <div class="dust">
                                    <span></span><span></span><span></span><span></span>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <!-- Right: Text -->
            <div class="col-lg-5 order-1 order-lg-2">
                <div class="p-3 p-lg-4">
                    <div class="kicker mb-3">
                        <span class="k-dot"></span>
                        <span>NOT FOUND</span>
                    </div>

                    <div class="big-code">404</div>
                    <h2 class="mb-2">Page not found</h2>

                    <p class="text-muted mb-4 nf-muted">
                        The page you’re looking for doesn’t exist or was moved.
                        Please use the button below to return to the homepage.
                    </p>

                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2">
                        <i class="bi bi-house-door me-1"></i> Go to Home
                    </a>

                    <div class="mt-4 tiny nf-muted">
                        If you typed the address manually, double-check the URL.
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style nonce="@nonce">
    /* ============================================================
           Theme tokens (Light default)
           Works with Bootstrap 5.3 data-bs-theme="dark"
           ============================================================ */
    :root {
        --nf-ink: rgba(15,23,42,.92);
        --nf-muted: rgba(15,23,42,.70);
        --nf-card: rgba(255,255,255,.86);
        --nf-card-border: rgba(15,23,42,.10);
        --nf-shadow: rgba(2,6,23,.14);
        --nf-accent1: #0d6efd; /* primary */
        --nf-accent2: #22c55e; /* green */

        --nf-bg-a: rgba(13,110,253,.16);
        --nf-bg-b: rgba(34,197,94,.12);
        --nf-wrap-grad-top: #ffffff;
        --nf-wrap-grad-mid: #f8fafc;
        --nf-sky1: #cfefff;
        --nf-sky2: #eaf7ff;
        --nf-star: rgba(255,255,255,.90);
        --nf-road1: #2b2f38;
        --nf-road2: #232734;
        --nf-road-glow: rgba(255,255,255,.08);
        --nf-lane: rgba(255,255,255,.85);
        --nf-sign-sub: rgba(255,255,255,.92);
        --nf-cloud: rgba(255,255,255,.88);
        --nf-cloud2: rgba(255,255,255,.92);
        --nf-mountain1: rgba(15,23,42,.18);
        --nf-mountain2: rgba(15,23,42,.02);
        --nf-bird: rgba(15,23,42,.55);
        --nf-bus-border: rgba(255,255,255,.22);
        --nf-bus-strip: rgba(255,255,255,.16);
        --nf-bus-glass1: rgba(255,255,255,.56);
        --nf-bus-glass2: rgba(255,255,255,.16);
        --nf-bus-window1: rgba(255,255,255,.58);
        --nf-bus-window2: rgba(255,255,255,.14);
        --nf-bus-door: rgba(2,6,23,.20);
        --nf-wheel: #0b1220;
        --nf-wheel-border: rgba(255,255,255,.12);
        --nf-rim: rgba(255,255,255,.30);
        --nf-boom: rgba(255,255,255,.92);
        --nf-boom-border: rgba(15,23,42,.10);
        --nf-barrier-bg: rgba(255,255,255,.14);
        --nf-barrier-border: rgba(255,255,255,.18);
        --nf-dust: rgba(255,255,255,.55);
        --nf-particle-glow: rgba(255,213,79,.18);
        --nf-particle-w: rgba(255,255,255,.12);
        --nf-particle-g: rgba(34,197,94,.14);
        --nf-caption-bg: rgba(255,255,255,.86);
        --nf-caption-border: rgba(15,23,42,.08);
    }

    /* Dark theme overrides (Bootstrap) */
    [data-bs-theme="dark"] {
        --nf-ink: rgba(226,232,240,.92);
        --nf-muted: rgba(226,232,240,.70);
        --nf-card: rgba(15,23,42,.60);
        --nf-card-border: rgba(148,163,184,.16);
        --nf-shadow: rgba(0,0,0,.42);
        --nf-bg-a: rgba(13,110,253,.20);
        --nf-bg-b: rgba(34,197,94,.16);
        --nf-wrap-grad-top: #0b1220;
        --nf-wrap-grad-mid: #0f172a;
        --nf-sky1: #0b1b34;
        --nf-sky2: #0f2746;
        --nf-star: rgba(255,255,255,.75);
        --nf-road1: #0b1220;
        --nf-road2: #0a0f1a;
        --nf-road-glow: rgba(255,255,255,.10);
        --nf-lane: rgba(255,255,255,.75);
        --nf-cloud: rgba(255,255,255,.20);
        --nf-cloud2: rgba(255,255,255,.24);
        --nf-mountain1: rgba(226,232,240,.12);
        --nf-mountain2: rgba(226,232,240,.02);
        --nf-bird: rgba(226,232,240,.55);
        --nf-bus-border: rgba(255,255,255,.18);
        --nf-bus-strip: rgba(255,255,255,.10);
        --nf-bus-glass1: rgba(255,255,255,.22);
        --nf-bus-glass2: rgba(255,255,255,.08);
        --nf-bus-window1: rgba(255,255,255,.22);
        --nf-bus-window2: rgba(255,255,255,.08);
        --nf-bus-door: rgba(2,6,23,.34);
        --nf-wheel: #050913;
        --nf-wheel-border: rgba(255,255,255,.10);
        --nf-rim: rgba(255,255,255,.22);
        --nf-boom: rgba(2,6,23,.72);
        --nf-boom-border: rgba(148,163,184,.18);
        --nf-barrier-bg: rgba(255,255,255,.10);
        --nf-barrier-border: rgba(255,255,255,.12);
        --nf-dust: rgba(255,255,255,.28);
        --nf-particle-glow: rgba(255,213,79,.14);
        --nf-particle-w: rgba(255,255,255,.10);
        --nf-particle-g: rgba(34,197,94,.12);
        --nf-caption-bg: rgba(2,6,23,.62);
        --nf-caption-border: rgba(148,163,184,.12);
    }

    /* ===== Wrapper ===== */
    .nf-wrap {
        min-height: calc(100vh - 120px);
        color: var(--nf-ink);
        background: radial-gradient(1200px 600px at 12% 10%, var(--nf-bg-a), transparent 60%), radial-gradient(900px 520px at 90% 15%, var(--nf-bg-b), transparent 58%), linear-gradient(180deg, var(--nf-wrap-grad-top) 0%, var(--nf-wrap-grad-mid) 65%, var(--nf-wrap-grad-top) 100%);
    }

    .nf-muted {
        color: var(--nf-muted) !important;
    }

    .kicker {
        display: inline-flex;
        align-items: center;
        gap: .55rem;
        padding: .38rem .75rem;
        border-radius: 999px;
        border: 1px solid rgba(148,163,184,.18);
        background: color-mix(in srgb, var(--nf-card) 72%, transparent);
        box-shadow: 0 12px 26px rgba(2,6,23,.10);
        letter-spacing: .12em;
        font-size: .78rem;
        font-weight: 700;
        color: var(--nf-muted);
        backdrop-filter: blur(10px);
    }

    .k-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--nf-accent1), var(--nf-accent2));
        box-shadow: 0 10px 24px rgba(13,110,253,.20);
    }

    .big-code {
        font-weight: 900;
        font-size: 4.2rem;
        line-height: 1;
        letter-spacing: -0.06em;
        background: linear-gradient(135deg, var(--nf-accent1), var(--nf-accent2));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: .35rem;
    }

    .tiny {
        font-size: .9rem;
        opacity: .9;
    }

    /* ===== Scene Card ===== */
    .scene {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 26px 60px var(--nf-shadow);
        background: transparent;
    }

    .scene-body {
        position: relative;
        height: 380px;
        background: color-mix(in srgb, var(--nf-card) 30%, transparent);
    }

    /* ===== Sky ===== */
    .sky {
        position: absolute;
        inset: 0;
        height: 60%;
        background: radial-gradient(500px 260px at 20% 20%, rgba(255,255,255,.20), rgba(255,255,255,0) 60%), linear-gradient(180deg, var(--nf-sky1) 0%, var(--nf-sky2) 55%, rgba(255,255,255,0) 100%);
    }

    .stars {
        position: absolute;
        inset: 0;
        opacity: .25;
        background-image: radial-gradient(var(--nf-star) 1px, transparent 1px), radial-gradient(color-mix(in srgb, var(--nf-star) 86%, transparent) 1px, transparent 1px);
        background-size: 40px 40px, 70px 70px;
        background-position: 0 0, 22px 16px;
        mask-image: linear-gradient(180deg, rgba(0,0,0,.9), rgba(0,0,0,0));
    }

    .sun {
        position: absolute;
        left: 22px;
        top: 18px;
        width: 64px;
        height: 64px;
        border-radius: 999px;
        background: radial-gradient(circle at 30% 30%, #fff7c9, #ffd54f);
        box-shadow: 0 22px 70px rgba(255,193,7,.26);
        animation: sunPulse 3.8s ease-in-out infinite;
        overflow: visible;
        filter: saturate(1.05);
    }

    @@keyframes sunPulse {
        0%, 100% {
            transform: scale(1);
            filter: brightness(1) saturate(1.05);
        }

        50% {
            transform: scale(1.05);
            filter: brightness(1.08) saturate(1.15);
        }
    }

    .ray {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 120px;
        height: 10px;
        transform-origin: 0 50%;
        border-radius: 999px;
        background: linear-gradient(90deg, rgba(255,213,79,.35), rgba(255,213,79,0));
        transform: translate(22px, -50%) rotate(0deg);
        filter: blur(.3px);
        opacity: .8;
        animation: raySpin 6.4s linear infinite;
    }

    .r2 {
        transform: translate(22px, -50%) rotate(45deg);
        opacity: .65;
    }

    .r3 {
        transform: translate(22px, -50%) rotate(90deg);
        opacity: .55;
    }

    .r4 {
        transform: translate(22px, -50%) rotate(135deg);
        opacity: .6;
    }

    @@keyframes raySpin {
        to {
            transform: translate(22px, -50%) rotate(360deg);
        }
    }

    .cloud {
        position: absolute;
        top: 30px;
        width: 128px;
        height: 42px;
        border-radius: 999px;
        background: var(--nf-cloud);
        box-shadow: 0 18px 42px rgba(2,6,23,.10);
        filter: blur(.2px);
    }

        .cloud::before, .cloud::after {
            content: "";
            position: absolute;
            background: var(--nf-cloud2);
            border-radius: 999px;
        }

        .cloud::before {
            width: 54px;
            height: 54px;
            left: 14px;
            top: -18px;
        }

        .cloud::after {
            width: 66px;
            height: 66px;
            left: 50px;
            top: -30px;
        }

    .c1 {
        left: 130px;
        top: 40px;
        animation: cloudMove 16s linear infinite;
    }

    .c2 {
        left: 300px;
        top: 18px;
        transform: scale(.86);
        opacity: .92;
        animation: cloudMove 22s linear infinite;
    }

    .c3 {
        left: 470px;
        top: 48px;
        transform: scale(.74);
        opacity: .85;
        animation: cloudMove 26s linear infinite;
    }

    @@keyframes cloudMove {
        0% {
            transform: translateX(0) scale(1);
        }

        100% {
            transform: translateX(160px) scale(1);
        }
    }

    .birds {
        position: absolute;
        right: 24px;
        top: 26px;
        opacity: .65;
    }

    .bird {
        display: inline-block;
        width: 22px;
        height: 10px;
        border-top: 2px solid var(--nf-bird);
        border-radius: 100% 100% 0 0;
        margin-left: 8px;
        animation: birdFly 2.8s ease-in-out infinite;
    }

    .b2 {
        animation-delay: .25s;
        opacity: .85;
        transform: scale(.92);
    }

    .b3 {
        animation-delay: .5s;
        opacity: .7;
        transform: scale(.82);
    }

    @@keyframes birdFly {
        0%, 100% {
            transform: translateY(0) rotate(6deg);
        }

        50% {
            transform: translateY(-4px) rotate(10deg);
        }
    }

    /* Mountains */
    .mountains {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -18px;
        height: 120px;
        opacity: .5;
        filter: blur(.2px);
    }

    .m {
        position: absolute;
        bottom: 0;
        width: 240px;
        height: 140px;
        background: linear-gradient(180deg, var(--nf-mountain1), var(--nf-mountain2));
        clip-path: polygon(0% 100%, 20% 60%, 40% 78%, 55% 52%, 70% 76%, 88% 45%, 100% 100%);
        border-radius: 18px;
    }

    .m1 {
        left: -20px;
        transform: scale(1.05);
    }

    .m2 {
        left: 180px;
        opacity: .75;
        transform: scale(.95);
    }

    .m3 {
        right: -30px;
        opacity: .6;
        transform: scale(1.1);
    }

    /* ===== Road ===== */
    .road {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 52%;
        background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(2,6,23,.03) 12%, rgba(2,6,23,.03) 100%), linear-gradient(180deg, var(--nf-road1) 0%, var(--nf-road2) 100%);
        overflow: hidden;
    }

    .road-perspective {
        position: absolute;
        left: -10%;
        right: -10%;
        top: 0;
        height: 100%;
        background: radial-gradient(900px 280px at 50% 0%, var(--nf-road-glow), rgba(255,255,255,0) 60%);
        transform: skewX(-10deg);
        opacity: .9;
    }

    .lane {
        position: absolute;
        left: -12%;
        right: -12%;
        top: 44%;
        height: 6px;
        background: repeating-linear-gradient(90deg, var(--nf-lane) 0 22px, rgba(255,255,255,0) 22px 46px);
        transform: skewX(-10deg);
        opacity: .9;
        animation: laneMove 1.1s linear infinite;
    }

    .lane2 {
        top: 62%;
        height: 5px;
        opacity: .55;
        animation-duration: 1.35s;
    }

    @@keyframes laneMove {
        0% {
            background-position: 0 0;
        }

        100% {
            background-position: 120px 0;
        }
    }

    /* Sign */
    .sign {
        position: absolute;
        left: 26px;
        bottom: 26px;
        width: 88px;
        text-align: center;
        transform: rotate(-4deg);
        filter: drop-shadow(0 18px 26px rgba(2,6,23,.22));
    }

    .sign-top {
        background: linear-gradient(135deg, var(--nf-accent1), var(--nf-accent2));
        color: #fff;
        font-weight: 900;
        border-radius: 14px;
        padding: 10px 0 6px;
        border: 1px solid rgba(255,255,255,.22);
    }

    .sign-sub {
        margin-top: 6px;
        font-size: 12px;
        font-weight: 700;
        color: var(--nf-sign-sub);
        text-shadow: 0 10px 22px rgba(2,6,23,.25);
    }

    .sign-post {
        width: 10px;
        height: 64px;
        margin: 8px auto 0;
        background: rgba(255,255,255,.55);
        border-radius: 10px;
        box-shadow: 0 10px 22px rgba(2,6,23,.12);
    }

    /* Barrier */
    .barrier {
        position: absolute;
        right: 80px;
        bottom: 38px;
        width: 110px;
        height: 44px;
        border-radius: 14px;
        background: var(--nf-barrier-bg);
        border: 1px solid var(--nf-barrier-border);
        box-shadow: 0 18px 34px rgba(2,6,23,.20);
        overflow: hidden;
        transform: rotate(2deg);
    }

    .stripe {
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(135deg, rgba(255,122,24,.95) 0 14px, rgba(255,255,255,.90) 14px 28px);
        opacity: .95;
    }

    .s2 {
        opacity: .65;
        filter: blur(.2px);
    }

    .s3 {
        opacity: .35;
        filter: blur(.6px);
    }

    /* ===== Bus ===== */
    .bus-wrap {
        position: absolute;
        left: 20%;
        bottom: 44px;
        width: 380px;
        height: 170px;
    }

    .bus-shadow {
        position: absolute;
        left: 22px;
        bottom: 8px;
        width: 280px;
        height: 34px;
        border-radius: 999px;
        background: rgba(0,0,0,.30);
        filter: blur(10px);
        opacity: .55;
    }

    .shake {
        animation: busDrive 2.9s ease-in-out infinite;
    }

    @@keyframes busDrive {
        0%, 100% {
            transform: translateX(0) rotate(0deg);
        }

        45% {
            transform: translateX(18px) rotate(-.4deg);
        }

        55% {
            transform: translateX(18px) rotate(.25deg);
        }
    }

    .bus {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 312px;
        height: 116px;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--nf-accent1), var(--nf-accent2));
        box-shadow: 0 26px 60px rgba(2,6,23,.34);
        border: 1px solid var(--nf-bus-border);
        overflow: hidden;
    }

    .bus-glow {
        position: absolute;
        inset: -40px;
        background: radial-gradient(240px 160px at 30% 30%, rgba(255,255,255,.24), transparent 60%);
        pointer-events: none;
    }

    .bus-strip {
        position: absolute;
        left: -30px;
        right: -30px;
        top: 62px;
        height: 22px;
        background: var(--nf-bus-strip);
        transform: skewX(-12deg);
    }

    .bus-front-glass {
        position: absolute;
        right: -12px;
        top: 14px;
        width: 96px;
        height: 54px;
        border-radius: 16px;
        background: linear-gradient(180deg, var(--nf-bus-glass1), var(--nf-bus-glass2));
        border: 1px solid rgba(255,255,255,.22);
        transform: skewX(-10deg);
    }

    .bus-windows {
        position: absolute;
        left: 18px;
        top: 14px;
        display: flex;
        gap: 10px;
    }

        .bus-windows .w {
            width: 42px;
            height: 32px;
            border-radius: 12px;
            background: linear-gradient(180deg, var(--nf-bus-window1), var(--nf-bus-window2));
            border: 1px solid rgba(255,255,255,.18);
        }

    .bus-door {
        position: absolute;
        right: 76px;
        bottom: 22px;
        width: 34px;
        height: 60px;
        border-radius: 12px;
        background: var(--nf-bus-door);
        border: 1px solid rgba(255,255,255,.14);
    }

    .bus-brand {
        position: absolute;
        left: 16px;
        bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 900;
        letter-spacing: .2px;
        color: rgba(255,255,255,.94);
        text-shadow: 0 12px 26px rgba(2,6,23,.22);
        font-size: 14px;
    }

    .logo-dot {
        width: 9px;
        height: 9px;
        border-radius: 999px;
        background: rgba(255,255,255,.92);
        box-shadow: 0 10px 22px rgba(2,6,23,.22);
    }

    .bus-lights {
        position: absolute;
        right: 10px;
        bottom: 20px;
        display: flex;
        gap: 6px;
    }

    .light {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: rgba(255,255,255,.92);
        box-shadow: 0 0 22px rgba(255,255,255,.45);
        animation: blink 1.1s ease-in-out infinite;
    }

    .l2 {
        opacity: .82;
        animation-delay: .25s;
    }

    @@keyframes blink {
        0%, 100% {
            transform: scale(1);
            opacity: .9;
        }

        50% {
            transform: scale(1.1);
            opacity: .55;
        }
    }

    .wheel {
        position: absolute;
        bottom: -16px;
        width: 46px;
        height: 46px;
