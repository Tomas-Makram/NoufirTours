<script nonce="@nonce">
    // Subtle parallax to add premium feel
    (function () {
        const card = document.querySelector('.scene-body');
        if (!card) return;

        const sun = card.querySelector('.sun');
        const clouds = card.querySelectorAll('.cloud');
        const mts = card.querySelectorAll('.m');

        function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

        card.addEventListener('mousemove', (e) => {
            const r = card.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;

            const sx = clamp(x * 10, -10, 10);
            const sy = clamp(y * 8, -8, 8);

            if (sun) sun.style.transform = `translate(${sx}px, ${sy}px)`;

            clouds.forEach((c, i) => {
                const k = (i + 1) * 2.0;
                c.style.transform = `translate(${sx * k}px, ${sy * k}px)`;
            });

            mts.forEach((m, i) => {
                const k = (i + 1) * 1.3;
                m.style.transform = `translate(${sx * k}px, ${sy * k}px)`;
            });
        });

        card.addEventListener('mouseleave', () => {
            if (sun) sun.style.transform = '';
            clouds.forEach((c) => (c.style.transform = ''));
            mts.forEach((m) => (m.style.transform = ''));
        });
    })();
</script>