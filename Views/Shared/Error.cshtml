@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
    var requestId = Model?.RequestId;
    var showRequestId = Model?.ShowRequestId == true && !string.IsNullOrWhiteSpace(requestId);

    var nonce = (Context.Items["CSPNonce"]?.ToString()) ?? "";
}

<div class="nf-error container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-7">

            <div class="card nf-card border-0 shadow-sm overflow-hidden">
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex align-items-start gap-3">
                        <!-- Optional icon -->
                        <div class="nf-icon-wrap flex-shrink-0">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h1 class="h4 mb-1">Oops! Something went wrong</h1>
                            <p class="nf-muted mb-0">
                                We couldn’t complete your request right now. Please try again, and if the problem continues contact support.
                            </p>
                        </div>
                    </div>

                    <hr class="my-4 nf-hr" />

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-4 nf-soft">
                                <div class="small nf-muted">Status</div>
                                <div class="fw-semibold">Unexpected error</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="p-3 rounded-4 nf-soft">
                                <div class="small nf-muted">Time</div>
                                <div class="fw-semibold">@DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        </div>
                    </div>

                    @if (showRequestId)
                    {
                        <div class="mt-3">
                            <div class="p-3 rounded-4 nf-box">
                                <div class="small nf-muted mb-1">Request ID</div>
                                <code class="d-block nf-code">@requestId</code>
                                <div class="small nf-muted mt-2">
                                    Share this ID with support to help us investigate.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>

                        <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                            <i class="bi bi-arrow-left me-1"></i> Go Back
                        </button>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-danger ms-auto">
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                        </a>
                    </div>

                    <div class="mt-4 small nf-muted">
                        If you were submitting a form, please avoid refreshing too quickly and try again.
                    </div>

                </div>
            </div>

            <div class="text-center mt-4 small nf-muted">
                © @DateTime.Now.Year NoufirTours · Error page
            </div>

        </div>
    </div>
</div>

<style nonce="@nonce">
    /* ============================================================
           Theme-aware tokens (Bootstrap friendly)
           ============================================================ */
    .nf-error {
        /* uses bs body colors automatically */
        color: var(--bs-body-color);
    }

    .nf-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 18px;
        box-shadow: 0 18px 45px rgba(0,0,0,.08);
    }

    /* Muted text that adapts */
    .nf-muted {
        color: var(--bs-secondary-color) !important;
    }

    .nf-hr {
        border-color: var(--bs-border-color);
        opacity: 1;
    }

    /* Soft panels: replace bg-light */
    .nf-soft {
        background: var(--bs-tertiary-bg);
        border: 1px solid color-mix(in srgb, var(--bs-border-color) 80%, transparent);
    }

    /* RequestId box */
    .nf-box {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
    }

    .nf-code {
        padding: .35rem .6rem;
        border-radius: 10px;
        background: color-mix(in srgb, var(--bs-tertiary-bg) 75%, transparent);
        border: 1px solid color-mix(in srgb, var(--bs-border-color) 80%, transparent);
        color: var(--bs-body-color);
        overflow-wrap: anywhere;
    }

    /* Icon */
    .nf-icon-wrap {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: color-mix(in srgb, var(--bs-danger) 12%, var(--bs-tertiary-bg));
        border: 1px solid color-mix(in srgb, var(--bs-danger) 22%, var(--bs-border-color));
        color: var(--bs-danger);
        box-shadow: 0 12px 30px rgba(0,0,0,.08);
        flex: 0 0 auto;
    }

        .nf-icon-wrap i {
            font-size: 1.2rem;
            line-height: 1;
        }

    /* Nice: slightly stronger shadow in dark mode */
    [data-bs-theme="dark"] .nf-card {
        box-shadow: 0 18px 55px rgba(0,0,0,.35);
    }
</style>