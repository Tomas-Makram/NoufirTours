                                                        else if (!IsSeat(c) && !IsWC(c))
                                                        {
                                                            <div class="cell-aisle"
                                                                 style="left:@(left)px; top:@(top)px; width:@(w)px; height:@(h)px;"
                                                                 title=""></div>
                                                        }
                                                        else
                                                        {
                                                            var code = (c.SeatCode ?? "").Trim();
                                                            var role = (c.Role ?? "Passenger").Trim();
                                                            var booked = (Model.UnavailableMain?.Contains(code) ?? false);

                                                            var cls = "cell-seat";

                                                            if (!c.IsActive) cls += " disabled";
                                                            else if (role.Equals("Driver", StringComparison.OrdinalIgnoreCase)) cls += " driver disabled";
                                                            else if (role.Equals("Assistant", StringComparison.OrdinalIgnoreCase)) cls += " assistant disabled";
                                                            else if (booked) cls += " booked disabled";
                                                            else if (!c.IsSelectable) cls += " disabled";
                                                            else cls += " available";

                                                            <div class="@cls"
                                                                 data-leg="main"
                                                                 data-seat="@code"
                                                                 style="left:@(left)px; top:@(top)px; width:@(w)px; height:@(h)px;"
                                                                 title="@($"{code} • {role}")">
                                                                @code
                                                            </div>
                                                        }
                                                    }
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- RETURN BUS -->
                    @if (Model.BookingMode == TripPriceType.Round)
                    {
                        <div class="col-lg-6">
                            <div class="card shadow-sm" style="border-radius:18px;">
                                <div class="card-header bg-white fw-semibold">
                                    RETURN Trip Bus
                                    <span class="text-muted small ms-2">@Model.ReturnBusName</span>
                                </div>

                                <div class="card-body">
                                    <div class="d-flex justify-content-center">
                                        <div class="bus-shell-portrait">
                                            <div class="bus-interior">
                                                <div class="grid-wrap">

                                                    <div class="door-layer">
                                                        @foreach (var c in (Model.GridReturn ?? new()).Where(x => x.HasDoor))
                                                        {
                                                            <div class="door" style="@DoorOverlayStyle(c.X, c.Y, Model.ReturnLayoutW, c.DoorSide, c.DoorOffset)" title="Door">
                                                                <div class="door-panel"></div>
                                                                <div class="door-panel"></div>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="grid"
                                                         style="width:@(Model.ReturnLayoutW* CELL)px; height:@(Model.ReturnLayoutH* CELL)px;
                                                        background-size:@(CELL)px @(CELL)px;
                                                        background-image:
                                                        linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
                                                        linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);">

                                                        @foreach (var c in (Model.GridReturn ?? new()))
                                                        {
                                                            var left = c.X * CELL + PAD;
                                                            var top = c.Y * CELL + PAD;
                                                            var w = CELL - PAD * 2;
                                                            var h = CELL - PAD * 2;

                                                            if (IsWC(c))
                                                            {
                                                                <div class="cell-wc"
                                                                     style="left:@(left)px; top:@(top)px; width:@(w)px; height:@(h)px;"
                                                                     title="WC">
                                                                    🚻
                                                                </div>
                                                            }
                                                            else if (IsAisle(c))
                                                            {
                                                                <div class="cell-aisle"
                                                                     style="left:@(left)px; top:@(top)px; width:@(w)px; height:@(h)px;"
                                                                     title="Aisle"></div>
                                                            }
                                                            else if (!IsSeat(c) && !IsWC(c))
                                                            {
                                                                <div class="cell-aisle"
                                                                     style="left:@(left)px; top:@(top)px; width:@(w)px; height:@(h)px;"
                                                                     title=""></div>
                                                            }
                                                            else
                                                            {
                                                                var code = (c.SeatCode ?? "").Trim();
                                                                var role = (c.Role ?? "Passenger").Trim();
                                                                var booked = (Model.UnavailableReturn?.Contains(code) ?? false);

                                                                var cls = "cell-seat";

                                                                if (!c.IsActive) cls += " disabled";
                                                                else if (role.Equals("Driver", StringComparison.OrdinalIgnoreCase)) cls += " driver disabled";
                                                                else if (role.Equals("Assistant", StringComparison.OrdinalIgnoreCase)) cls += " assistant disabled";
                                                                else if (booked) cls += " booked disabled";
                                                                else if (!c.IsSelectable) cls += " disabled";
                                                                else cls += " available";

                                                                <div class="@cls"
                                                                     data-leg="return"
                                                                     data-seat="@code"
                                                                     style="left:@(left)px; top:@(top)px; width:@(w)px; height:@(h)px;"
                                                                     title="@($"{code} • {role}")">
                                                                    @code
                                                                </div>
                                                            }
                                                        }
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>

                <!-- Legend -->
                <div class="legend">
                    <span><span class="dot" style="background: var(--seat-available-bg); border-color: var(--seat-available-border);"></span> Available</span>
                    <span><span class="dot" style="background: var(--seat-selected-bg); border-color: var(--seat-selected-border);"></span> Selected</span>
                    <span><span class="dot" style="background: var(--seat-booked-bg); border-color: var(--seat-booked-border);"></span> Booked</span>
                    <span><span class="dot" style="background: var(--seat-driver-bg); border-color: var(--seat-driver-border);"></span> Driver</span>
                    <span><span class="dot" style="background: var(--seat-assistant-bg); border-color: var(--seat-assistant-border);"></span> Assistant</span>
                    <span><span class="dot" style="background: linear-gradient(145deg, #f59e0b, #fbbf24); border-color: var(--door-border);"></span> Door</span>
                </div>
            </div>
        </div>
    </form>
</div>

<script nonce="@nonce">
    (function () {
      const bookingType = parseInt(document.getElementById('BookingType')?.value || "1", 10);

      const seatsMainHidden = document.getElementById('SeatsMainCsv');
      const seatsReturnHidden = document.getElementById('SeatsReturnCsv');
      const totalText = document.getElementById('TotalText');

      const priceGo = parseFloat('@Model.SeatPriceGo'.replace(',', '.')) || 0;
      const priceReturn = parseFloat('@Model.SeatPriceReturn'.replace(',', '.')) || 0;

      const reqMain = parseInt(document.getElementById('ReqMain')?.value || "1", 10);
      const reqReturn = parseInt(document.getElementById('ReqReturn')?.value || "1", 10);
      const isRound = (document.getElementById('IsRound')?.value || "0") === "1";

      const mainCountText = document.getElementById('MainCountText');
      const returnCountText = document.getElementById('ReturnCountText');
      const minWarn = document.getElementById('MinWarn');
      const confirmBtn = document.getElementById('ConfirmBtn');

      const selectedMain = new Set();
      const selectedReturn = new Set();

      function parseCsv(v){ return (v || '').split(',').map(x => x.trim()).filter(Boolean); }

      parseCsv(seatsMainHidden?.value).forEach(s => selectedMain.add(s));
      parseCsv(seatsReturnHidden?.value).forEach(s => selectedReturn.add(s));

      function syncHidden() {
        if (seatsMainHidden) seatsMainHidden.value = Array.from(selectedMain).join(',');
        if (seatsReturnHidden) seatsReturnHidden.value = Array.from(selectedReturn).join(',');
      }

      function calcTotal() {
        const mainCount = selectedMain.size;
        const retCount = selectedReturn.size;

        let total = 0;
        if (bookingType === 1) total = mainCount * priceGo;
        else if (bookingType === 2) total = mainCount * priceReturn;
        else total = (mainCount * priceGo) + (retCount * priceReturn);

        if (totalText) totalText.textContent = (Math.round(total * 100) / 100).toString();
      }

      function refreshSelectedUI() {
        document.querySelectorAll('.cell-seat[data-leg="main"]').forEach(el => {
          const s = el.getAttribute('data-seat') || '';
          if (!s) return;
          el.classList.toggle('selected', selectedMain.has(s));
        });
        document.querySelectorAll('.cell-seat[data-leg="return"]').forEach(el => {
          const s = el.getAttribute('data-seat') || '';
          if (!s) return;
          el.classList.toggle('selected', selectedReturn.has(s));
        });
      }

      function refreshMinRuleUI() {
        const m = selectedMain.size;
        const r = selectedReturn.size;

        if (mainCountText) mainCountText.textContent = String(m);
        if (returnCountText) returnCountText.textContent = String(r);

        let ok = true;
        let msg = "";

        if (m < reqMain) {
          ok = false;
          msg = "You must select at least " + reqMain + " seat(s) in MAIN.";
        }

        if (ok && isRound) {
          if (r < reqReturn) {
            ok = false;
            msg = "You must select at least " + reqReturn + " seat(s) in RETURN.";
          }
        }

        if (minWarn) {
          minWarn.style.display = ok ? "none" : "";
          minWarn.textContent = msg;
        }
        if (confirmBtn) confirmBtn.disabled = !ok;
      }

      document.addEventListener('click', function (e) {
        const el = e.target.closest('.cell-seat');
        if (!el) return;

        if (el.classList.contains('disabled') || el.classList.contains('booked') || el.classList.contains('driver') || el.classList.contains('assistant'))
          return;

        const seat = el.getAttribute('data-seat') || '';
        if (!seat) return;

        const leg = el.getAttribute('data-leg') || 'main';
        if (bookingType !== 3 && leg !== 'main') return;

        if (leg === 'main') {
          if (selectedMain.has(seat)) selectedMain.delete(seat);
          else selectedMain.add(seat);
        } else {
          if (selectedReturn.has(seat)) selectedReturn.delete(seat);
          else selectedReturn.add(seat);
        }

        syncHidden();
        refreshSelectedUI();
        calcTotal();
        refreshMinRuleUI();
      });

      // --------- AutoComplete for customers ----------
      const nameEl = document.getElementById('CustName');
      const phoneEl = document.getElementById('CustPhone');
      const namesList = document.getElementById('custNamesList');
      const phonesList = document.getElementById('custPhonesList');

      let lastRows = [];

      function setDatalistOptions(listEl, arr) {
        if (!listEl) return;
        listEl.innerHTML = "";
        (arr || []).forEach(v => {
          const opt = document.createElement('option');
          opt.value = v;
          listEl.appendChild(opt);
        });
      }

      let tmr = null;
      async function fetchSuggestions(q) {
        const url = '@Url.Action("CustomerSuggest", "Booking")' + '?q=' + encodeURIComponent(q || '');
        const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
        if (!res.ok) return [];
        const data = await res.json();
        return Array.isArray(data) ? data : [];
      }

      function scheduleSuggest(sourceEl) {
        if (!sourceEl) return;
        const q = (sourceEl.value || "").trim();
        if (q.length < 2) {
          lastRows = [];
          setDatalistOptions(namesList, []);
          setDatalistOptions(phonesList, []);
          return;
        }
        clearTimeout(tmr);
        tmr = setTimeout(async () => {
          const rows = await fetchSuggestions(q);
          lastRows = rows;

          const names = rows.map(x => x.name).filter(Boolean);
          const phones = rows.map(x => x.phone).filter(Boolean);

          setDatalistOptions(namesList, Array.from(new Set(names)));
          setDatalistOptions(phonesList, Array.from(new Set(phones)));
        }, 180);
      }

      function tryAutofillByName() {
        const name = (nameEl?.value || "").trim();
        if (!name) return;
        const row = lastRows.find(x => (x.name || "").toLowerCase() === name.toLowerCase());
        if (row && phoneEl && !phoneEl.value) phoneEl.value = row.phone || "";
      }

      function tryAutofillByPhone() {
        const phone = (phoneEl?.value || "").trim();
        if (!phone) return;
        const row = lastRows.find(x => (x.phone || "") === phone);
        if (row && nameEl && !nameEl.value) nameEl.value = row.name || "";
      }

      if (nameEl) {
        nameEl.addEventListener('input', () => scheduleSuggest(nameEl));
        nameEl.addEventListener('change', tryAutofillByName);
        nameEl.addEventListener('blur', tryAutofillByName);
      }
      if (phoneEl) {
        phoneEl.addEventListener('input', () => scheduleSuggest(phoneEl));
        phoneEl.addEventListener('change', tryAutofillByPhone);
        phoneEl.addEventListener('blur', tryAutofillByPhone);
      }

      syncHidden();
      refreshSelectedUI();
      calcTotal();
      refreshMinRuleUI();
    })();
</script>