@using System.Globalization
@using NoufirTours.Data
@model NoufirTours.Models.Bookings.BookingDetailsModel

@{
    ViewData["Title"] = "Trip Booking";
    var nonce = (Context.Items["CSPNonce"]?.ToString()) ?? "";

    string Money(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    const int CELL = 46;
    const int PAD = 4;

    const int DOOR_THICK = 16;
    const int DOOR_LEN = 38;
    const int DOOR_GAP = 8;

    bool IsSeat(NoufirTours.Models.Bookings.SeatCellModel c)
        => (c.ElementType ?? "Seat").Equals("Seat", StringComparison.OrdinalIgnoreCase)
           && !string.IsNullOrWhiteSpace(c.SeatCode);

    bool IsWC(NoufirTours.Models.Bookings.SeatCellModel c)
        => (c.ElementType ?? "").Equals("WC", StringComparison.OrdinalIgnoreCase);

    bool IsAisle(NoufirTours.Models.Bookings.SeatCellModel c)
        => (c.ElementType ?? "").Equals("Aisle", StringComparison.OrdinalIgnoreCase);

    bool IsPassengerSelectableSeat(NoufirTours.Models.Bookings.SeatCellModel c, HashSet<string> unavailable)
    {
        if (!IsSeat(c)) return false;
        var code = (c.SeatCode ?? "").Trim();
        var role = (c.Role ?? "Passenger").Trim();
        if (!c.IsActive) return false;
        if (!c.IsSelectable) return false;
        if (!role.Equals("Passenger", StringComparison.OrdinalIgnoreCase)) return false;
        if (string.IsNullOrWhiteSpace(code)) return false;
        if (unavailable?.Contains(code) ?? false) return false;
        return true;
    }

    int ReadIntQS(string key, int fallback)
    {
        var s = Context.Request.Query[key].ToString();
        if (int.TryParse(s, out var v) && v > 0) return v;
        return fallback;
    }

    // المطلوب القادم من Index (QS)
    var qsSeats = ReadIntQS("seats", 1);
    var qsReturnSeats = ReadIntQS("returnSeats", 1);

    // المتاح فعلاً في الباص/الباصين (Seats قابلة للاختيار وغير محجوزة)
    var availMainSelectable = (Model.GridMain ?? new())
        .Count(c => IsPassengerSelectableSeat(c, Model.UnavailableMain ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase)));

    var availReturnSelectable = (Model.GridReturn ?? new())
        .Count(c => IsPassengerSelectableSeat(c, Model.UnavailableReturn ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase)));

    // القاعدة:
    // - لازم يختار >= العدد اللي حدده في Index
    // - لو المتاح أقل من المطلوب => لازم يختار كل المتاح
    int requiredMain = Math.Max(1, Model.RequiredMainSeats);
    int requiredReturn = Math.Max(1, Model.RequiredReturnSeats);
    var isRound = Model.BookingMode == TripPriceType.Round;

    string DoorOverlayStyle(int x, int y, int w, string? sideRaw, double? offsetRaw)
    {
        var side = (sideRaw ?? "").Trim().ToUpperInvariant();
        if (side != "L" && side != "R" && side != "T" && side != "B")
            side = (x <= 0) ? "L" : (x >= w - 1 ? "R" : (x >= (w / 2) ? "R" : "L"));

        var offset = offsetRaw.HasValue ? Math.Clamp(offsetRaw.Value, 0.0, 1.0) : 0.5;

        var cellLeft = x * CELL;
        var cellTop = y * CELL;

        int pxLeft, pxTop;
        int wDoor, hDoor;

        if (side == "L")
        {
            pxLeft = cellLeft - DOOR_THICK - DOOR_GAP;
            pxTop = cellTop + (int)Math.Round((CELL - DOOR_LEN) * offset);
            wDoor = DOOR_THICK; hDoor = DOOR_LEN;
        }
        else if (side == "R")
        {
            pxLeft = cellLeft + CELL + DOOR_GAP;
            pxTop = cellTop + (int)Math.Round((CELL - DOOR_LEN) * offset);
            wDoor = DOOR_THICK; hDoor = DOOR_LEN;
        }
        else if (side == "T")
        {
            pxLeft = cellLeft + (int)Math.Round((CELL - DOOR_LEN) * offset);
            pxTop = cellTop - DOOR_THICK - DOOR_GAP;
            wDoor = DOOR_LEN; hDoor = DOOR_THICK;
        }
        else
        {
            pxLeft = cellLeft + (int)Math.Round((CELL - DOOR_LEN) * offset);
            pxTop = cellTop + CELL + DOOR_GAP;
            wDoor = DOOR_LEN; hDoor = DOOR_THICK;
        }

        return $"left:{pxLeft}px; top:{pxTop}px; width:{wDoor}px; height:{hDoor}px;";
    }

    string ModeLabel =
        Model.BookingMode == TripPriceType.Go ? "Go" :
        Model.BookingMode == TripPriceType.Return ? "Return" :
        "Round (Go + Return)";

    // نص بسيط للمطلوب
    string RequiredTextMain =
        (availMainSelectable <= 0) ? "No selectable seats." :
        (qsSeats > availMainSelectable)
            ? $"Required: select ALL available seats ({availMainSelectable})."
            : $"Required: select at least {requiredMain} seat(s).";

    string RequiredTextReturn =
        (availReturnSelectable <= 0) ? "No selectable seats." :
        (qsReturnSeats > availReturnSelectable)
            ? $"Required (Return): select ALL available seats ({availReturnSelectable})."
            : $"Required: select at least {requiredReturn} seat(s).";
}

