                <div class="col-lg-3 col-6">
                    <div class="k">Route</div>
                    <div class="v">@Model.FromCity → @Model.ToCity</div>
                </div>

                <div class="col-lg-6">
                    <div class="k">Pickup place</div>
                    <div class="v">@((string.IsNullOrWhiteSpace(Model.PickupPlace) ? "-" : Model.PickupPlace))</div>
                </div>
                <div class="col-lg-6">
                    <div class="k">Dropoff place</div>
                    <div class="v">@((string.IsNullOrWhiteSpace(Model.DropoffPlace) ? "-" : Model.DropoffPlace))</div>
                </div>

                @if (Model.BookingMode == TripPriceType.Round)
                {
                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-lg-6">
                        <div class="k">Return trip</div>
                        <div class="v">@Model.ReturnTripName</div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="k">Return depart</div>
                        <div class="v">@((Model.ReturnDepartDate ?? "-")) @((Model.ReturnDepartTime ?? "-"))</div>
                    </div>
                    <div class="col-lg-3 col-6">
                        <div class="k">Return route</div>
                        @if (Model.FromCity == Model.ReturnFromCity)
                        {
                            <div class="v">@Model.ReturnToCity → @Model.ReturnFromCity</div>
                        }
                        else
                        {
                            <div class="v">@Model.ReturnFromCity → @Model.ReturnToCity</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
