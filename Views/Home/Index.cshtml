@{
    ViewData["Title"] = "NoufirTours";
    var nonce = (Context.Items["CSPNonce"]?.ToString()) ?? "";
}

<style nonce="@nonce">
    /* =========================
           Layout + Theme
           ========================= */
    .hero-wrap {
        border-radius: 22px;
        padding: 30px;
        border: 1px solid rgba(13,110,253,.12);
        position: relative;
        overflow: hidden;
        background: radial-gradient(1200px 650px at 8% 10%, rgba(13,110,253,.18), transparent 60%), radial-gradient(900px 560px at 92% 25%, rgba(25,135,84,.14), transparent 55%), linear-gradient(135deg, rgba(13,110,253,.08), rgba(25,135,84,.06));
        box-shadow: 0 14px 40px rgba(0,0,0,.08);
    }

    [data-bs-theme="dark"] .hero-wrap {
        border-color: rgba(255,255,255,.10);
        background: radial-gradient(1200px 650px at 8% 10%, rgba(13,110,253,.22), transparent 60%), radial-gradient(900px 560px at 92% 25%, rgba(25,135,84,.18), transparent 55%), linear-gradient(135deg, rgba(13,110,253,.14), rgba(25,135,84,.10));
        box-shadow: 0 14px 44px rgba(0,0,0,.40);
    }

    .brand {
        font-weight: 900;
        letter-spacing: .2px;
        line-height: 1.05;
        margin: 0;
    }

        .brand .n {
            color: #0d6efd;
        }

        .brand .t {
            color: #ffc107;
        }

    .hero-sub {
        color: rgba(0,0,0,.62);
        max-width: 64ch;
        font-size: 1.05rem;
        margin-top: .6rem;
        margin-bottom: 1.2rem;
    }

    [data-bs-theme="dark"] .hero-sub {
        color: rgba(255,255,255,.72);
    }

    .muted {
        color: rgba(0,0,0,.60);
    }

    [data-bs-theme="dark"] .muted {
        color: rgba(255,255,255,.66);
    }

    /* =========================
           Motion (CSS only / CSP-safe)
           ========================= */
    .floaters {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .blob {
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 999px;
        filter: blur(1px);
        opacity: .55;
        transform: translate3d(0,0,0);
        animation: drift 10s ease-in-out infinite;
        border: 1px solid rgba(255,255,255,.25);
        background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.35), rgba(255,255,255,0) 55%), radial-gradient(circle at 70% 70%, rgba(13,110,253,.35), rgba(13,110,253,0) 60%);
        mix-blend-mode: soft-light;
    }

    [data-bs-theme="dark"] .blob {
        opacity: .35;
        border-color: rgba(255,255,255,.14);
        mix-blend-mode: screen;
        background: radial-gradient(circle at 30% 30%, rgba(255,255,255,.18), rgba(255,255,255,0) 55%), radial-gradient(circle at 70% 70%, rgba(13,110,253,.45), rgba(13,110,253,0) 60%);
    }

    .blob.b1 {
        top: -60px;
        left: -70px;
        animation-duration: 11s;
    }

    .blob.b2 {
        top: 15%;
        right: -80px;
        width: 260px;
        height: 260px;
        animation-duration: 13s;
    }

    .blob.b3 {
        bottom: -90px;
        left: 38%;
        width: 280px;
        height: 280px;
        animation-duration: 15s;
    }

    @@keyframes drift {
        0% {
            transform: translate(0,0) scale(1);
        }

        50% {
            transform: translate(18px,-14px) scale(1.05);
        }

        100% {
            transform: translate(0,0) scale(1);
        }
    }

    .shine {
        position: absolute;
        inset: 0;
        background: linear-gradient(120deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.18) 35%, rgba(255,255,255,0) 70%);
        transform: translateX(-120%);
        animation: sheen 6.5s ease-in-out infinite;
        opacity: .65;
        pointer-events: none;
    }

    [data-bs-theme="dark"] .shine {
        opacity: .35;
    }

    @@keyframes sheen {
        0% {
            transform: translateX(-120%);
        }

        45% {
            transform: translateX(120%);
        }

        100% {
            transform: translateX(120%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .blob, .shine {
            animation: none !important;
        }

        .scan-btn {
            transition: none !important;
        }

        .cardish {
            transition: none !important;
        }
    }

    /* =========================
           UI Blocks
           ========================= */
    .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: .75rem;
    }

    .chip {
        display: inline-flex;
        gap: .45rem;
        align-items: center;
        padding: .35rem .75rem;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(255,255,255,.70);
        font-weight: 700;
        font-size: .9rem;
        white-space: nowrap;
        backdrop-filter: blur(8px);
    }

    [data-bs-theme="dark"] .chip {
        border-color: rgba(255,255,255,.14);
        background: rgba(255,255,255,.04);
    }

    .cardish {
        border-radius: 18px;
        border: 1px solid rgba(0,0,0,.08);
        background: rgba(255,255,255,.74);
        padding: 16px;
        height: 100%;
        transition: transform .14s ease, box-shadow .14s ease;
        backdrop-filter: blur(10px);
    }

    [data-bs-theme="dark"] .cardish {
        border-color: rgba(255,255,255,.10);
        background: rgba(255,255,255,.03);
    }

    .cardish:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(0,0,0,.10);
    }

    [data-bs-theme="dark"] .cardish:hover {
        box-shadow: 0 12px 28px rgba(0,0,0,.42);
    }

    .icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,.10);
        background: rgba(255,255,255,.78);
        flex: 0 0 auto;
    }

    [data-bs-theme="dark"] .icon {
        border-color: rgba(255,255,255,.14);
        background: rgba(255,255,255,.05);
    }

    .scan-btn {
        padding: .85rem 1.15rem;
        border-radius: 14px;
        font-weight: 900;
        letter-spacing: .2px;
        position: relative;
        overflow: hidden;
        transform: translate3d(0,0,0);
        transition: transform .14s ease, box-shadow .14s ease;
    }

        .scan-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 30px rgba(13,110,253,.22);
        }

    [data-bs-theme="dark"] .scan-btn:hover {
        box-shadow: 0 16px 34px rgba(0,0,0,.55);
    }

    .scan-btn::after {
        content: "";
        position: absolute;
        inset: -40% -60%;
        background: radial-gradient(circle at 20% 20%, rgba(255,255,255,.55), rgba(255,255,255,0) 45%), radial-gradient(circle at 70% 70%, rgba(255,255,255,.20), rgba(255,255,255,0) 55%);
        transform: translateX(-30%);
        opacity: .25;
        transition: opacity .2s ease, transform .2s ease;
        pointer-events: none;
    }

    .scan-btn:hover::after {
        opacity: .45;
        transform: translateX(10%);
    }

    .footer-strip {
        margin-top: 1.25rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: .5rem;
        font-size: .9rem;
    }
</style>

<div class="container py-4 py-lg-5">

    <div class="hero-wrap">
        <!-- Motion layers -->
        <div class="floaters" aria-hidden="true">
            <div class="blob b1"></div>
            <div class="blob b2"></div>
            <div class="blob b3"></div>
            <div class="shine"></div>
        </div>

        <div class="position-relative">
            <div class="chip-row">
                <span class="chip">🚌 Trips</span>
                <span class="chip">🎫 Tickets</span>
                <span class="chip">🔒 CSP Ready</span>
                <span class="chip">✨ Smooth UI</span>
            </div>

            <h1 class="display-6 brand">
                <span class="n">Noufir</span><span class="t">Tours</span>
            </h1>

            <p class="hero-sub">
                A clean, modern system for trip management and ticket validation — designed to be fast, secure, and theme-aware.
            </p>

            <!-- Only ONE button (Scan Ticket) -->
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary scan-btn" href="/Home/Scan">
                    Scan Ticket
                </a>
            </div>

            <div class="mt-3 muted small">
                Tip: This page uses CSS-only motion (CSP-friendly) and adapts automatically to Light/Dark mode.
            </div>

            <div class="row g-3 mt-2">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="cardish">
                        <div class="d-flex gap-3">
                            <div class="icon">⚡</div>
                            <div>
                                <div class="fw-bold mb-1">Fast Workflow</div>
                                <div class="muted">Open, scan, validate — in seconds.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="cardish">
                        <div class="d-flex gap-3">
                            <div class="icon">🛡️</div>
                            <div>
                                <div class="fw-bold mb-1">Secure by Design</div>
                                <div class="muted">CSP + Nonce compatible UI patterns.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="cardish">
                        <div class="d-flex gap-3">
                            <div class="icon">🌙</div>
                            <div>
                                <div class="fw-bold mb-1">Theme Aware</div>
                                <div class="muted">Looks great in Light and Dark mode.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-strip muted">
                <div>© @DateTime.Now.Year NoufirTours</div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span>Light/Dark Ready</span>
                    <span>•</span>
                    <span>Bootstrap UI</span>
                    <span>•</span>
                    <span>Print Friendly</span>
                </div>
            </div>
        </div>
    </div>

</div>